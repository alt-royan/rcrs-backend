{
  "CORSRules": [
    {
      "AllowedOrigins": [
        "*"
      ],
      "AllowedMethods": [
        "PUT",
        "POST",
        "GET",
        "HEAD",
        "DELETE"
      ],
      "AllowedHeaders": [
        "*"
      ],
      "ExposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type",
        "Content-Range",
        "Content-Disposition",
        "Accept-Ranges"
      ],
      "MaxAgeSeconds": 3000
    }
  ]
}
